        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好"
          }
        }
      }
    },
    "On macOS 15, enable ntfs3g in Settings, then select a volume to mount it with xntfs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
