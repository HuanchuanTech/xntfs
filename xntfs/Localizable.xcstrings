    },
    "NTFS drives mount automatically under /Volumes via the file-system extension. Use this app to eject, remount read-only, mount to a folder you choose, or open a disk image." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NTFS 磁盘会通过文件系统扩展自动挂载到 /Volumes。本应用可用于推出、以只读方式重新挂载、挂载到你选择的文件夹,或打开磁盘映像。"
          }
        }
      }
    },
    "NTFS extension not enabled" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
