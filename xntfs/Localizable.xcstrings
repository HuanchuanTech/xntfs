{
  "sourceLanguage" : "en",
  "strings" : {
    "This volume is read-only (e.g. an image attached read-only) and can only be mounted read-only." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该卷为只读(例如以只读方式 attach 的镜像),只能以只读方式挂载。"
          }
        }
      }
    },
    "%@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
