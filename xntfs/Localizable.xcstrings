    },
    "ntfs3g is enabled in System Settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ntfs3g 已在系统设置中启用。"
          }
        }
      }
    },
    "ntfs3g is included in this app. macOS 15 cannot reliably report third-party FSKit registration or enablement to the app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
